package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libtmsnfc_nci_jni",

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Werror",
        // #ifdef TMS_NFC
        "-Wno-error=date-time",
        // #endif
        "-DNXP_UICC_ENABLE",
        "-DTMS_NFC",
    ],

    srcs: ["**/*.cpp"],
    exclude_srcs: ["NfcTagTest.cpp"],

    include_dirs: [
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/nfa/include",
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/nfc/include",
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/include",
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/gki/ulinux",
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/gki/common",
        "vendor/tms/sys/opensource/libtmsnfc-nci/utils/include",
        "vendor/tms/sys/opensource/libtmsnfc-nci/src/tms",
    ],

    shared_libs: [
        "libnativehelper",
        "libcutils",
        "libutils",
        "liblog",
        "libtmsnfc-nci",
        "libchrome",
        "libbase",
        "libstatslog_nfc_tms",
    ],

    static_libs: ["libxml2"],

    product_variables: {
        debuggable: {
            cflags: [
                "-DDCHECK_ALWAYS_ON",
                "-DDTA_ENABLED"
            ],
        },
    },
    sanitize: {
        integer_overflow: true,
        misc_undefined: ["bounds"],
        scs: true,
    },
}
