package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "tms-statslog-Nfc-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module nfc --javaPackage com.android.nfc"
        + " --javaClass NfcStatsLog",
    out: ["com/android/nfc/NfcStatsLog.java"],
}

// #ifdef TMS_NFC
bootstrap_go_package {
    name: "soong-tms_nfcnci",
    pkgPath: "android/soong/tms_nfcnci",
    deps: [
        "soong-android",
        "soong-java",
    ],
    srcs: [
        "tms_nfcnci.go",
    ],
    pluginFor: ["soong_build"],
}

tms_nfcnci_default{
    name: "tms_nfcnci_default",
}
// #endif

// NCI Configuration
android_app {
    name: "NfcNci_tms",
    srcs: [
        // "src/**/*.java",
        "src/com/android/**/*.java",
        "src/com/tms/nfc/**/*.java",
        "nci/**/*.java",
        ":tms-statslog-Nfc-java-gen",
    ],
    defaults:["tms_nfcnci_default"],
    platform_apis: true,
    certificate: "platform",
    jni_libs: ["libtmsnfc_nci_jni"],
    libs: [
        "com.tms.nfc",
    ],
    static_libs: [
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "PlatformProperties",
        // "vendor.tms.wiredse-V1.0-java",
    ],
    optimize: {
        enabled: false,
    },
    uses_libs: ["com.tms.nfc"],
}

filegroup {
    name: "tmsnfc-sources",
    srcs: [
        // "src/**/*.java",
        "src/com/android/**/*.java",
        ":tms-statslog-Nfc-java-gen",
    ],
    visibility: [
        "//vendor/tms/sys/opensource/Nfc/tests/unit",
    ],
}
