package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_nfc_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["tms_system_nfc_license"],
}

cc_defaults {
    name: "tms_nfc_utils_defaults",
    include_dirs: [
        "vendor/tms/sys/opensource/libtmsnfc-nci",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DTMS_NFC",
    ],
    target: {
        host_linux: {
            cflags: ["-D_GNU_SOURCE"],
        },
        darwin: {
            enabled: false,
        },
    },
    sanitize: {
        integer_overflow: true,
        misc_undefined: ["bounds"],
        scs: true,
    },

}

cc_library_static {
    name: "libtmsnfcutils",
    defaults: ["tms_nfc_utils_defaults"],
    export_include_dirs: ["include"],
    host_supported: true,
    srcs: [
        "config.cc",
        "ringbuffer.cc",
    ],
    shared_libs: [
        "libbase",
    ],

}

cc_test {
    name: "tms_nfc_test_utils",
    defaults: ["tms_nfc_utils_defaults"],
    test_suites: ["device-tests"],
    host_supported: true,
    srcs: [
        "test/config_test.cc",
        "test/ringbuffer_test.cc",
    ],
    static_libs: [
        "libtmsnfcutils",
        "libgmock",
    ],
    shared_libs: [
        "libbase",
    ],
}

cc_fuzz {
    name: "tms_nfc_utils_ringbuffer_fuzzer",
    host_supported: true,
    srcs: [
        "test/ringbuffer_fuzzer/ringbuffer_fuzzer.cpp",
    ],
    static_libs: [
        "libtmsnfcutils",
    ],
    corpus: [
        "test/ringbuffer_fuzzer/corpus/*",
    ],
}
