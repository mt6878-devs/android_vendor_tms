package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_nfc_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["tms_system_nfc_license"],
}

bootstrap_go_package {
    name: "soong-tms_libnfc_nci",
    pkgPath: "android/soong/tms_libnfc_nci",
    deps: [
        "soong-android",
        "soong-cc",
    ],
    srcs: [
          "tms_libnfc_nci.go",
    ],
    pluginFor: ["soong_build"],
}

tms_libnfc_nci_default {
    name:"tms_libnfc_nci_default",
}


cc_library_shared {
    arch: {
        arm: {
            instruction_set: "arm",
        },
    },
    name: "libtmsnfc-nci",
    defaults: ["tms_libnfc_nci_default"],
    shared_libs: [
        "libcutils",
        "liblog",
        "libdl",
        "libz",
        "libchrome",
        "libbase",
        "libstatslog_nfc_tms",

        // Treble configuration
        "libhidlbase",
        "libutils",
        "android.hardware.nfc@1.0",
        "android.hardware.nfc@1.1",
        "android.hardware.nfc@1.2",
        // Add for AIDL
        "android.hardware.nfc-V1-ndk",
        "libbinder_ndk",
    ],
    static_libs: [
        "libtmsnfcutils",
    ],
    cflags: [
        "-DDYN_ALLOC=1",
        "-DBUILDCFG=1",
        "-DGKI_PTHREAD_JOINABLE",
        "-Wall",
        "-Werror",
        "-Wimplicit-fallthrough",
        "-Wno-error=date-time",
        "-DTMS_NFC",
        "-DTMS_NFC_FORUM=FALSE"
    ],
    local_include_dirs: [
        "include",
        "gki/ulinux",
        "gki/common",
        "nfa/include",
        "nfc/include",
        "tms"
    ],
    srcs: [
        "nfa/ce/*.cc",
        "nfa/dm/*.cc",
        "nfa/ee/*.cc",
        "nfa/hci/*.cc",
        "nfa/p2p/*.cc",
        "nfa/rw/*.cc",
        "nfa/sys/*.cc",
        "nfa/t4tnfcee/*.cc",
        "nfc/llcp/*.cc",
        "nfc/nci/*.cc",
        "nfc/ndef/*.cc",
        "nfc/nfc/*.cc",
        "nfc/tags/*.cc",
        "adaptation/*.cc",
        "gki/common/*.cc",
        "gki/ulinux/*.cc",
    ],

    // #ifndef TMS_NFC
    // Copy moved to tmsNfcSystemConfig.mk
    /*
    required: [
        // Provide a default libnfc-nci.conf in /system/etc for devices that
        // does not ship one in /product
        "libnfc-nci.conf-default",
    ],
    */
    // #endif

    product_variables: {
        debuggable: {
            cflags: [
                "-DDCHECK_ALWAYS_ON",
            ],
        },
    },
    sanitize: {
        misc_undefined: ["bounds"],
        integer_overflow: true,
        scs: true,
    },

}

