cc_library {
    name: "libstatslog_nfc_tms",
    host_supported: true,
    generated_sources: ["statslog_nfc_tms.cpp"],
    generated_headers: ["statslog_nfc_tms.h"],
    export_generated_headers: ["statslog_nfc_tms.h"],
    shared_libs: [
        "libcutils",
    ],
    target: {
        android: {
            shared_libs: [
                "libstatssocket",
            ],
        },
        host: {
            static_libs: [
                "libstatssocket",
            ],
        },
        darwin: {
            enabled: false,
        },
    },
}

genrule {
    name: "statslog_nfc_tms.h",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --header $(genDir)/statslog_nfc_tms.h --module nfc --namespace nfc,stats",
    out: [
        "statslog_nfc_tms.h",
    ],
}

genrule {
    name: "statslog_nfc_tms.cpp",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --cpp $(genDir)/statslog_nfc_tms.cpp --module nfc --namespace nfc,stats --importHeader statslog_nfc_tms.h",
    out: [
        "statslog_nfc_tms.cpp",
    ],
}
