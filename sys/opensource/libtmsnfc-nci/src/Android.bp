genrule {
    name: "TmsNfcGeneratedPackets_rust",
    tools: [
        "bluetooth_packetgen",
    ],
    cmd: "$(location bluetooth_packetgen) --include=vendor/tms/sys/opensource/libtmsnfc-nci/src --out=$(genDir) $(in) --rust",
    srcs: [
        "nci_packets.pdl",
    ],
    out: [
        "nci_packets.rs",
    ],
}

rust_library {
    name: "libnfc_packets_tms",
    defaults: ["tms_nfc_rust_defaults"],
    crate_name: "nfc_packets",
    srcs: ["rust/packets/lib.rs", ":TmsNfcGeneratedPackets_rust"],
    host_supported: true,
    proc_macros: ["libnum_derive"],
    rustlibs: [
        "libbytes",
        "libnum_traits",
        "libthiserror",
        "liblog_rust",
    ],
}

rust_test_host {
    name: "libnfc_packets_test_tms",
    defaults: ["tms_nfc_rust_defaults"],
    srcs: ["rust/packets/lib.rs", ":TmsNfcGeneratedPackets_rust"],
    test_suites: ["general-tests"],
    proc_macros: ["libnum_derive"],
    rustlibs: [
        "libbytes",
        "libnum_traits",
        "libthiserror",
        "liblog_rust",
    ],
}
