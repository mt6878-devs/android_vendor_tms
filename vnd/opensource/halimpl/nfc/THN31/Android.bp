cc_library_shared {
    name: "nfc_nci.thn31nfc.tms",
    defaults: ["hidl_defaults"],
    proprietary: true,

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-DTMS_NFC",
        "-DI2C_PATCH",
        "-DUSE_TMS_NFC",
        "-DUSED_COS_I2C_DL",

    ],

    srcs: [
        "halimpl/hal/TmsNciHal.cc",
        "halimpl/hal/TmsNciHal_dta.cc",
        "halimpl/hal/TmsNciHal_ext.cc",
        "halimpl/hal/TmsNciHal_IoctlOperations.cc",
        "halimpl/hal/Tmsnfc.cc",
        "halimpl/log/TmsLog.cc",
        "halimpl/tml/Dal4Nfc_messageQueueLib.cc",
        "halimpl/tml/OsalNfc_Timer.cc",
        "halimpl/tml/TmlNfc.cc",
        "halimpl/tml/NfccTransportFactory.cc",
        "halimpl/tml/transport/*.cc",
        "halimpl/utils/TmsNfcCapability.cc",
        "halimpl/utils/TmsNfcThreadMutex.cc",
        "halimpl/utils/TmsConfig.cc",
        "halimpl/utils/TmsNciHal_utils.cc",
        "halimpl/utils/Sparse_crc32.cc",
    ],

    local_include_dirs: [
        "halimpl/common",
        "halimpl/hal",
        "halimpl/inc",
        "halimpl/log",
        "halimpl/tml/transport",
        "halimpl/tml",
        "halimpl/utils",
    ],

    include_dirs: [
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "libhardware",
        "libhardware_legacy",
        "libhidlbase",
        "liblog",
        "libutils",
        "tms-utils",
        "tms-cos-dl-common",
        "tms-cos-dl-ree",
    ],
}
