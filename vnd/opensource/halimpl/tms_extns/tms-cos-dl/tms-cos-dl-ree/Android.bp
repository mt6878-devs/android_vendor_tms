cc_library_shared {

    name: "tms-cos-dl-ree",
    owner: "tms",
    vendor : true,
    //vndk: {
    //    enabled: true,
    //},
    defaults: [
        "hidl_defaults",
        "cond_tms_dl_ree_lib",
    ],

    srcs: [
        //tmsCosI2cDl.cpp: compile or not base on USED_COS_I2C_DL maco defined
        "tmsCosI2cDl.cpp",
        //tmsCosWiredModeDl.cpp: compile or not base on USED_COS_REE_SPI maco defined
        "tmsCosWiredModeDl.cpp",
        //tmsCosReeSpiDl.cpp: compile or not base on USED_COS_REE_SPI maco defined
        "tmsCosReeSpiDl.cpp",
        "TmsRee.cpp",
        "TmsWiredMode.cpp",
        "tmsReeDlCommonUtils.cpp",

        "tmsDlNciUtils.cpp",
        "tmsNfccDl.cpp",
    ],

    local_include_dirs: [
        "include",
    ],

    export_include_dirs: [
        "include",
    ],

    cflags: [
        "-DI2C_PATCH",
        "-DTMS_REE",
    ],

    shared_libs: [
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libutils",
        "liblog",
        "libbase",
        "android.hardware.nfc@1.0",
        "libutilscallstack",

        "tms-utils",
        "tms-cos-dl-common",
        "7816-3-T1",
    ],
}

