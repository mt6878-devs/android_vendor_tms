cc_library_shared {

    name: "tms-cos-dl-tee",
    owner: "tms",
    vendor : true,
    //vndk: {
    //    enabled: true,
    //},
    defaults: [
        "hidl_defaults",
        "cond_tms_dl_tee_lib",
    ],

    srcs: [
        "tmsCosTeeSpiDl.cpp",
        "TmsTee.cpp",
    ],

    local_include_dirs: [
        "include",
    ],

    export_include_dirs: [
        "include",
    ],

    cflags: [
        "-DTMS_TEE",
    ],

    shared_libs: [
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libutils",
        "liblog",
        "libbase",
        "android.hardware.nfc@1.0",
        "libutilscallstack",

        "tms-utils",
        "tms-cos-dl-common",
        "7816-3-T1",
    ],
}

