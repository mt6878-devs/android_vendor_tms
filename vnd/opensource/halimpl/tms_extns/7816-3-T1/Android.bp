cc_library_shared {

    name: "7816-3-T1",
    owner: "tms",
    vendor : true,
    defaults: [
        "hidl_defaults",
        "cond_7816_lib",
    ],
    //proprietary: true,

    srcs: [
        "7816/*.c",
        "adaptation/*.cpp",
        "ph-driver/*.c",
        "utils/*.cpp",
    ],

    local_include_dirs: [
        "adaptation/include",
        "include",
    ],

    export_include_dirs: [
        "adaptation/include",
        "include",
    ],

    cflags: [
        "-DANDROID",
        "-DBUILDCFG=1",
        "-Wall",
        "-Werror",
        "-Wno-error=date-time",
        "-Wno-date-time",

        "-DDBG_LEVEL_STACK",
        "-DUSE_SPI_SPLIT_READ",
        "-DLRC_CRC_0",
        "-DDBG_LEVEL_1",
    ],

    shared_libs: [
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libutils",
        "liblog",
        "libbase",
        "android.hardware.nfc@1.0",

        "libutilscallstack",
        "tms-utils",
    ],
}
