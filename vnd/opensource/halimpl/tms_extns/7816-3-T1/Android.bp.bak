bootstrap_go_package {
    name: "soong-condition_android_bp",
    pkgPath: "android/soong/condition_android_bp",
    deps: [
        "soong-android",
        "soong-cc",
    ],
    srcs: [
          "condition_android_bp.go",
    ],
    pluginFor: ["soong_build"],
}

cc_cond_library {
    name: "cond_defaults",
}

cc_library_shared {

    name: "7816-3-T1",
    defaults: [
        "hidl_defaults",
        "cond_defaults",
    ],
    proprietary: true,

    srcs: [
        "utils/*.c",
        "utils/*.cc",
        "ph-driver/*.c",
        "config/*.cc",
        "7816/*.c",
        "adaptation/*.cpp",
        "cos-dl/src/*.cpp",
    ],

    local_include_dirs: [
        "cos-dl/inc",
        "adaptation/include",
    ],

    export_include_dirs: [
        "cos-dl/inc",
        "include",
    ],

    include_dirs: [
        //"vendor/tms/secure_element/7816-3-T1/adaptation/include",
    ],

    cflags: [
        "-DANDROID",
        "-DBUILDCFG=1",
        "-Wall",
        "-Werror",
        "-Wno-error=date-time",
        "-Wno-date-time",

        "-DDBG_LEVEL_STACK",
        //"-DDBG_LEVEL_1",
        "-DUSE_SPI_SPLIT_READ",
        "-DLRC_CRC_0",
        "-DI2C_TMP_PATCH",
    ],

    shared_libs: [
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libutils",
        "liblog",
        "libbase",
        "android.hardware.nfc@1.0",

        "libutilscallstack",
    ],
}
