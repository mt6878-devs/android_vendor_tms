cc_binary {
    name: "android.hardware.secure_element@1.2-service-tms",
    defaults: ["hidl_defaults"],
    proprietary: true,
    init_rc: ["android.hardware.secure_element@1.2-service-tms.rc"],
    relative_install_path: "hw",
    srcs: [
        "*.cpp",
    ],

    shared_libs: [
        "android.hardware.secure_element@1.0",
        "android.hardware.secure_element@1.1",
        "android.hardware.secure_element@1.2",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "7816-3-T1",
    ],
}
