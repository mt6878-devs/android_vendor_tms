cc_binary {
    name: "android.hardware.secure_element-service-tms",
    defaults: [
        "hidl_defaults",
        "cond_se_bin",
    ],
    proprietary: true,
    init_rc: ["secure_element-service-tms.rc"],
    vintf_fragments: ["secure_element-service-tms.xml"],
    relative_install_path: "hw",
    srcs: [
        "SEService.cpp",
        "SecureElement.cpp",
        "extns/impl/*.cpp",
    ],

    cflags: [
        //"-DCHECK_UNION_PARAM",
    ],

    shared_libs: [
        //"android.hardware.secure_element-V1-ndk", //see condition_android_bp.go
        "vendor.tms.tmsese_aidl-V1-ndk",
        "libbinder_ndk",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "tms-utils",
        "7816-3-T1",
        "tms-cos-dl-common",
        "tms-cos-dl-ree",
        "tms-cos-dl-tee",
        //see condition_android_bp.go
    ],

    local_include_dirs: [
        "extns/impl",
    ],

    include_dirs: [
        //see condition_android_bp.go
    ],
}
