package vendor.tms.tmsese@1.1;

import @1.0::ITmsEse;

interface ITmsEse extends @1.0::ITmsEse {
    /**
     * Sets Mtk platform spi clk state.
     *
     * @param boolean input true if setting enable, false if setting disable
     * @return result as a boolean, true if success, false if failed
     *
     */
    setMtkSpiClk(bool enable) generates (bool result);

    /**
     * Performs an action based on the command.
     *
     * @param cmd Commands to be executed
     * @param inData Input parameters required to execute commands
     * @return outData The data returned after the command is executed.
     * @return status action performs result.
     *
     */
    generic(uint32_t cmd, vec<uint8_t> inData)
        generates (vec<uint8_t> outData, int32_t status);
};
