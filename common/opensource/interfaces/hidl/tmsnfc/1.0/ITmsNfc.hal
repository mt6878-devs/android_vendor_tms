package vendor.tms.tmsnfc@1.0;

interface ITmsNfc {
    /*
     * Gets vendor params values whose Key has been provided.
     *
     * @param string
     * @return output data as string
     */
    getVendorParam(string key)  generates (string value);

    /*
     * Sets Transit config value
     *
     * @param string transit config value
     * @return status as a boolean, true if success, false if failed
     */
    setTmsTransitConfig(string transitConfValue) generates (bool status);

    /*
     * soft reset the ese
     *
     * @return status as a boolean, true if success, false if failed
     */
    EseSoftReset() generates (bool status);

    /*
     * download nfcc fw
     *
     * @return  status as a int16_t, true if success, false if failed
     */
    nfccFwDownload() generates (bool status);

    /*
     * Performs an action based on the ioctlType.
     *
     *
     * @return action performs result.
     */
    doAction(uint64_t ioctlType)  generates (int16_t status);

    /*
     * Check if conf file has modified
     *
     * @param uint8_t file type
     * @return true if file timestamp has modified
     */
    isConfigModified(uint8_t fileType)  generates (bool result);
};
